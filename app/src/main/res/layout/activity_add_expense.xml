<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_bg" android:fillViewport="true" android:clipToPadding="false" >
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:clipToPadding="false">
    <ImageView android:id="@+id/btn_back_add" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="16dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/ui_001" android:padding="12dp" android:clickable="true" android:focusable="true" android:tint="@color/accent_purple" android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_002" android:textColor="@color/text_primary" android:textSize="29sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_add_group_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_003" android:textColor="@color/text_secondary" android:textSize="14sp"/>
    <!-- Expense Name -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/ui_004" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <EditText android:id="@+id/et_expense_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_005" android:inputType="textCapSentences" android:singleLine="true" android:background="@drawable/sm_input" android:padding="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:minHeight="56dp" android:textSize="16sp" android:selectAllOnFocus="false"/>
    <!-- Amount -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_006" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <EditText android:id="@+id/et_expense_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/ui_007" android:inputType="numberDecimal" android:singleLine="true" android:imeOptions="flagNoExtractUi|actionDone" android:background="@drawable/sm_input" android:padding="16dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:minHeight="56dp" android:textSize="16sp" android:selectAllOnFocus="false"/>
    <!-- Category -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_008" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <Spinner android:id="@+id/spinner_category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <!-- Paid By -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_009" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <Spinner android:id="@+id/spinner_paid_by" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <!-- Date -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_010" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <Button android:id="@+id/btn_select_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:backgroundTint="@color/soft_purple" android:text="@string/ui_011" android:textAllCaps="false" android:textColor="@color/accent_purple" android:minHeight="52dp" android:textSize="15sp" android:fontFamily="sans" android:elevation="0dp"/>
    <TextView android:id="@+id/tv_expense_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp" android:textColor="@color/accent_purple" android:textSize="14sp"/>
    <!-- Save -->
    <Button android:id="@+id/btn_save_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:layout_marginBottom="24dp" android:backgroundTint="@color/accent_purple" android:text="@string/ui_012" android:textAllCaps="false" android:textColor="@color/contrast_on_purple" android:textSize="15sp" android:minHeight="52dp" android:fontFamily="sans" android:elevation="0dp"/>
  </LinearLayout>
</ScrollView>
