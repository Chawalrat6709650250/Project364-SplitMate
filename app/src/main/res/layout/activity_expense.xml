<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_bg" android:fillViewport="true" android:clipToPadding="false" >
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:clipToPadding="false">
    <!-- Back Button -->
    <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="16dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/ui_001" android:padding="12dp" android:clickable="true" android:focusable="true" android:tint="@color/accent_purple" android:background="?attr/selectableItemBackgroundBorderless"/>
    <!-- Group Name -->
    <TextView android:id="@+id/tv_group_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_003" android:textColor="@color/text_primary" android:textSize="29sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_029" android:textColor="@color/text_secondary" android:textSize="14sp"/>
    <!-- Total Expense Card -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/sm_hero" android:orientation="vertical" android:padding="24dp">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ui_017" android:textColor="#FFFFFFFF" android:textSize="15sp"/>
      <TextView android:id="@+id/tv_total_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ui_018" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"/>
    </LinearLayout>
    <!-- Expense List Header -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/ui_030" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
    <!-- Empty State -->
    <TextView android:id="@+id/tv_empty_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:gravity="center" android:padding="32dp" android:text="@string/ui_031" android:textColor="@color/text_secondary" android:textSize="15sp" android:visibility="visible" android:background="@drawable/sm_card"/>
    <!-- Expense List Container -->
    <LinearLayout android:id="@+id/expense_list_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <!-- Add Expense Button -->
    <Button android:id="@+id/btn_add_expense" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="20dp" android:backgroundTint="@color/accent_purple" android:text="@string/ui_032" android:textAllCaps="false" android:textColor="@color/contrast_on_purple" android:textSize="15sp" android:minHeight="52dp" android:fontFamily="sans" android:elevation="0dp"/>
  </LinearLayout>
</ScrollView>
