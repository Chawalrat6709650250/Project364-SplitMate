<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F7F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <ImageView
            android:id="@+id/btnBackAddMember"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#6759D9"
            android:contentDescription="ย้อนกลับ"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="เพิ่มสมาชิก"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#292940"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="กรอกชื่อสมาชิกที่ต้องการเพิ่มเข้ากลุ่ม"
        android:textSize="14sp"
        android:textColor="#77768C"
        android:layout_marginTop="24dp"/>

    <EditText
        android:id="@+id/etMemberName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="เช่น น้ำ, ฟ้า, ต้น"
        android:inputType="textPersonName"
        android:maxLength="50"
        android:singleLine="true"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:backgroundTint="#6759D9"/>

    <Button
        android:id="@+id/btnSaveMember"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="เพิ่มสมาชิก"
        android:textAllCaps="false"
        android:layout_marginTop="24dp"/>

</LinearLayout>
