<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/screen_bg" android:fillViewport="true" android:clipToPadding="false" >
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:clipToPadding="false">
    <ImageView android:id="@+id/btn_back_split" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginTop="16dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/ui_001" android:padding="12dp" android:clickable="true" android:focusable="true" android:tint="@color/accent_purple" android:background="?attr/selectableItemBackgroundBorderless"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ui_045" android:textColor="@color/text_primary" android:textSize="29sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tv_split_group_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ui_003" android:textColor="@color/text_secondary" android:textSize="14sp"/>
    <!-- Expense summary -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/sm_hero" android:orientation="vertical" android:padding="24dp">
      <TextView android:id="@+id/tv_split_expense_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_046" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
      <TextView android:id="@+id/tv_split_expense_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_018" android:textColor="#FFFFFFFF" android:textSize="22sp" android:textStyle="bold"/>
      <TextView android:id="@+id/tv_split_paid_by" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/ui_047" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
    </LinearLayout>
    <!-- Notice (e.g. amount changed, member removed) -->
    <TextView android:id="@+id/tv_split_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/sm_alert" android:padding="20dp" android:textColor="@color/alert_text" android:textSize="13sp" android:visibility="gone"/>
    <!-- Split method -->
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/ui_048" android:textColor="@color/text_primary" android:textStyle="bold"/>
    <RadioGroup android:id="@+id/rg_split_method" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
      <RadioButton android:id="@+id/rb_equal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:checked="true" android:text="@string/ui_049"/>
      <RadioButton android:id="@+id/rb_custom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_050"/>
    </RadioGroup>
    <!-- Members -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ui_051" android:textColor="@color/text_primary" android:textStyle="bold"/>
      <Button android:id="@+id/btn_select_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:backgroundTint="@color/soft_purple" android:minHeight="52dp" android:text="@string/ui_052" android:textAllCaps="false" android:textColor="@color/accent_purple" android:textSize="15sp" android:fontFamily="sans" android:elevation="0dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/split_member_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
    <TextView android:id="@+id/tv_split_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/ui_053" android:textColor="@color/text_secondary" android:visibility="gone"/>
    <!-- Summary -->
    <TextView android:id="@+id/tv_split_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/sm_card" android:gravity="center" android:padding="20dp" android:text="@string/ui_054" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold"/>
    <Button android:id="@+id/btn_save_split" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="24dp" android:backgroundTint="@color/accent_purple" android:text="@string/ui_055" android:textAllCaps="false" android:textColor="@color/contrast_on_purple" android:textSize="15sp" android:minHeight="52dp" android:fontFamily="sans" android:elevation="0dp"/>
  </LinearLayout>
</ScrollView>
